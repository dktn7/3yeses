{
  "name": "3yeses",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:3002": "next dev -p 3002",
    "check-server": "echo Checking for running Next.js servers... && netstat -ano | findstr :300",
    "kill-servers": "echo Stopping all Node.js processes on ports 3001-3002... && for /f \"tokens=5\" %a in ('netstat -ano ^| findstr :300') do taskkill /F /PID %a 2>nul",
    "dev:clean": "npm run kill-servers && npm run dev:3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:signup": "playwright test tests/e2e/signup-parental-consent.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "seed:test-data": "node ./scripts/seed-test-data.mjs",
    "seed:real-media": "node ./scripts/seed-admin-and-talents.mjs",
    "seed:prod-accounts": "node ./scripts/ensure-prod-admin-and-test.mjs",
    "seed:categories": "node ./scripts/ensure-categories.mjs",
    "seed:150": "node ./scripts/generate-150-talents.mjs",
    "seed:add-rich-portfolio": "node ./scripts/add-rich-portfolio.mjs",
    "agentdev": "agent-dev-cli run",
    "agent:server": "node agent-runtime/agent-server/index.js",
    "agent:server:watch": "nodemon agent-runtime/agent-server/index.js",
    "secret-scan:local": "node scripts/secret-scan-local.js",
    "prepare": "husky install",
    "locale:find-dupes": "node scripts/find-duplicate-keys.js messages/en.json messages/en-gb.json",
    "locale:dedupe": "node scripts/dedupe-locales.js --dry-run messages/en.json messages/en-gb.json"
  },
  "dependencies": {
    "@imagekit/next": "^2.1.5",
    "@imagekit/nodejs": "^7.3.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-node": "^0.212.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@prisma/client": "^6.19.2",
    "@tanstack/react-query": "^5.90.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.2",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^6.6.2",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.2",
    "next": "^16.0.0",
    "next-intl": "^4.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "phosphor-react": "^1.4.1",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.6.0",
    "react-phone-number-input": "^3.4.13",
    "react-player": "^2.16.0",
    "react-select": "^5.10.2",
    "recharts": "^3.3.0",
    "resend": "^6.4.1",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "stripe": "^20.3.1",
    "swr": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.0",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-dev-cli": "^1.0.7",
    "eslint": "^8.44.0",
    "eslint-config-next": "14.2.3",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.56.0",
    "postcss": "^8",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.1",
    "husky": "^8.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4",
    "zod": "^3.23.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
