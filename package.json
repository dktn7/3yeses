{
  "name": "3yeses",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "dev:3002": "next dev -p 3002",
    "check-server": "echo Checking for running Next.js servers... && netstat -ano | findstr :300",
    "kill-servers": "echo Stopping all Node.js processes on ports 3001-3002... && for /f \"tokens=5\" %a in ('netstat -ano ^| findstr :300') do taskkill /F /PID %a 2>nul",
    "dev:clean": "npm run kill-servers && npm run dev:3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:signup": "playwright test tests/e2e/signup-parental-consent.spec.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.15.5",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.2",
    "next": "^16.0.0",
    "next-intl": "^4.4.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "react": "^19",
    "react-dom": "^19",
    "react-icons": "^5.5.0",
    "react-phone-number-input": "^3.4.13",
    "react-player": "^2.16.0",
    "react-select": "^5.10.2",
    "recharts": "^3.3.0",
    "resend": "^6.4.1",
    "sharp": "^0.34.5",
    "stripe": "^20.3.1",
    "swr": "^2.3.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^8.44.0",
    "eslint-config-next": "14.2.3",
    "playwright": "^1.56.0",
    "postcss": "^8",
    "prisma": "^6.14.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "zod": "^3.23.2"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
