// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model SupportTicketMessage {
  id String @id @default(cuid())

  // The ticket this message belongs to
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String

  // Optional author (null for guest/system messages)
  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  // Message body
  content String @db.Text

  // Indicates whether message was sent by an admin/staff
  isStaff Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([authorId])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  email         String    @unique
  password      String
  role          UserRole  @default(TALENT)
  name          String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?

  // Password reset fields
  resetToken       String?
  resetTokenExpiry DateTime?

  // Email verification fields
  verificationToken       String?
  verificationTokenExpiry DateTime?

  // Parental consent fields (for users aged 13-15 with self-managed accounts)
  parentalConsentRequired  Boolean?  @default(false)
  parentalConsentPending   Boolean?  @default(false)
  parentalConsentGiven     Boolean?  @default(false)
  parentName               String?
  parentEmail              String?
  parentConsentToken       String?
  parentConsentTokenExpiry DateTime?
  parentConsentedAt        DateTime?

  // User settings (stored as JSON)
  settings Json?

  talentProfile TalentProfile?
  subscriptions Subscription[]
  payments      Payment[]
  profileLikes  ProfileLike[]
  comments      Comment[]
  commentLikes  CommentLike[]

  // Reports
  reportsCreated  ContentReport[] @relation("ReportedBy")
  reportsReceived ContentReport[] @relation("ReportedUser")
  reportsHandled  ContentReport[] @relation("ReportHandler")

  // Analytics
  profileViews   ProfileView[]
  portfolioViews PortfolioView[]

  // Advanced Admin Features
  authoredContent ContentVersion[]
  userSessions    UserSession[]
  activityLogs    ActivityLog[]
  emailLogs       EmailLog[]

  // Financials & Verification
  transactions                FinancialTransaction[]
  handledVerificationRequests VerificationRequest[]

  // Support & Operations
  supportTicketsCreated  SupportTicket[]        @relation("TicketCreator")
  supportTicketsAssigned SupportTicket[]        @relation("TicketAssignee")
  supportMessages        SupportTicketMessage[]
  kbArticlesAuthored     KnowledgeBaseArticle[]
  mediaAssetsUploaded    MediaAsset[]

  // Admin Notification State
  adminNotifState AdminNotificationState? @relation("AdminNotifState")
}

model TalentProfile {
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  performerTitle  String? @map("roleDescription") // e.g., "Lead Actress"
  bio             String?
  location        String?
  experienceLevel String? @map("experience") // "Beginner (0-2 years)", etc.

  // Detailed characteristics
  dateOfBirth    DateTime? // Added for age calculation
  gender         Gender?
  genderOther    String? // For custom gender specification
  ethnicity      Ethnicity?
  ethnicityOther String? // For custom ethnicity specification
  age            Int?
  height         Int? // in cm
  bodyType       BodyType?
  eyeColor       String?
  hairColor      String?

  languages      SpokenLanguage[] // Relation for proficiency levels
  skills         String[]
  featuredSkills String[]         @default([]) // User-selected skills to display on card (max 4)

  // Disability/accessibility information (optional, for inclusive casting)
  disabilities    String[] @default([]) // Array of disability types
  disabilityOther String? // Custom disability specification

  avatarSource      String? // New field to specify the source of the avatar (e.g., 'url', 'upload', etc.)
  bannerSource      String? // New field to specify the source of the banner (e.g., 'url', 'upload', etc.)
  avatarUrl         String? // Updated to support multiple sources
  bannerUrl         String? // Updated to support multiple sources
  contentBackground String? // Customizable background for content section (preset id or hex color)
  videoUrl          String?
  portfolioImages   String[] @default([]) // Array of image URLs
  videoUrls         String[] @default([]) // Array of video URLs (YouTube, Vimeo, etc.)

  socialMedia Json? // [{ platform: "Instagram", url: "..." }]
  portfolio   PortfolioItem[]
  workHistory WorkHistory[]
  comments    Comment[]

  viewCount    Int           @default(0)
  likeCount    Int           @default(0)
  profileLikes ProfileLike[]
  isBeginner   Boolean       @default(false)

  // Profile completion
  profileComplete Boolean @default(false)

  // Profile visibility settings
  profileSettings ProfileSettings?

  category      TalentCategory?    @relation(fields: [categoryId], references: [id])
  categoryId    String?
  subcategory   TalentSubcategory? @relation(fields: [subcategoryId], references: [id])
  subcategoryId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reports
  reports ContentReport[]

  // Analytics
  profileViews      ProfileView[]
  searchAppearances SearchAppearance[]
  profileStats      ProfileStats[]

  // Notifications
  notifications TalentNotification[]

  // Verification & Background Checks
  verified             Boolean               @default(false)
  verificationRequests VerificationRequest[]
  backgroundChecks     BackgroundCheck[]

  featuredItems FeaturedItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([userId])
  // Performance indexes for search/filtering
  @@index([gender])
  @@index([ethnicity])
  @@index([bodyType])
  @@index([age])
  @@index([height])
  @@index([location])
  @@index([viewCount])
  @@index([createdAt])
  @@index([skills])
}

model ProfileSettings {
  id              String        @id @default(cuid())
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String        @unique

  // Visibility settings
  showViewCount       Boolean @default(true)
  showExperienceLevel Boolean @default(true)
  showLocation        Boolean @default(true)
  showLanguages       Boolean @default(true)
  showWorkHistory     Boolean @default(true)
  showSocialMedia     Boolean @default(true)
  showContactInfo     Boolean @default(true)

  // Privacy settings
  profileVisibility  ProfileVisibility @default(PUBLIC)
  searchable         Boolean           @default(true)
  allowDirectContact Boolean           @default(true)
  showOnlineStatus   Boolean           @default(false)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  CONTACTS_ONLY
}

model SpokenLanguage {
  id          String              @id @default(cuid())
  name        String // e.g., "English", "Spanish"
  proficiency LanguageProficiency // Native, Fluent, Intermediate, Basic

  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  createdAt DateTime @default(now())

  @@unique([talentProfileId, name])
  @@map("Language")
}

enum LanguageProficiency {
  NATIVE
  FLUENT
  INTERMEDIATE
  BASIC
}

model TalentCategory {
  id             String              @id @default(cuid())
  name           String              @unique
  description    String?
  icon           String?
  subcategories  TalentSubcategory[]
  talentProfiles TalentProfile[]

  @@map("Category")
}

model TalentSubcategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  talentCount Int     @default(0)

  category   TalentCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  // subSubcategories field removed
  talentProfiles TalentProfile[]

  @@unique([categoryId, name])
  @@map("Subcategory")
}

model WorkHistory {
  id          String    @id @default(cuid())
  title       String
  company     String
  startDate   DateTime
  endDate     DateTime? // Null means "Present"
  isCurrent   Boolean   @default(false)
  description String?

  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Growth & Promotion
model AdBanner {
  id       String     @id @default(cuid())
  title    String
  imageUrl String
  linkUrl  String?
  position AdPosition @default(SIDEBAR)

  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)

  // Basic stats
  impressions Int @default(0)
  clicks      Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position, active])
  @@index([startDate, endDate])
}

enum AdPosition {
  HEADER
  SIDEBAR
  FOOTER
  FEED
  HERO
}

model FeaturedItem {
  id String @id @default(cuid())

  // Can feature a profile or a portfolio item
  talentProfile   TalentProfile? @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String?

  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  portfolioItemId String?

  title       String? // Override title if needed
  description String? // Override description

  slot     String // e.g., "HOMEPAGE_HERO", "CATEGORY_TOP"
  priority Int    @default(0) // Higher shows first

  startDate DateTime?
  endDate   DateTime?
  active    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slot, active])
  @@index([priority])
}

// SubSubcategory model removed
model PortfolioItem {
  id             String            @id @default(cuid())
  title          String
  mediaUrl       String            @map("url")
  type           PortfolioItemType
  thumbnail      String?
  imagekitFileId String?
  likeCount      Int               @default(0) @map("likes")
  description    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId])
  talentProfileId String

  comments Comment[]
  reports  ContentReport[]
  views    PortfolioView[]

  featuredItems FeaturedItem[]

  @@index([type])
  @@index([talentProfileId])
  @@index([createdAt])
}

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus @default(ACTIVE)

  startDate  DateTime  @default(now())
  endDate    DateTime?
  cancelAt   DateTime?
  canceledAt DateTime?

  // Stripe/Payment provider info
  stripeSubscriptionId String? @unique
  stripeCustomerId     String?
  stripePriceId        String?

  // Billing period
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  transactions FinancialTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([plan])
}

model Payment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount   Int // in cents
  currency String        @default("gbp")
  status   PaymentStatus @default(PENDING)

  // Stripe payment info
  stripePaymentIntentId String? @unique
  stripeInvoiceId       String?

  description String?
  metadata    Json? // Flexible storage for additional payment data

  transactions FinancialTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ProfileLike {
  id              String        @id @default(cuid())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  createdAt DateTime @default(now())

  @@unique([userId, talentProfileId]) // Prevent duplicate likes
  @@map("Like")
}

enum UserRole {
  TALENT
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
  OTHER
}

enum Ethnicity {
  WHITE_CAUCASIAN
  BLACK_AFRICAN
  ASIAN
  HISPANIC_LATINO
  MIDDLE_EASTERN
  MIXED_MULTIRACIAL
  NATIVE_AMERICAN
  PACIFIC_ISLANDER
  PREFER_NOT_TO_SAY
  OTHER
}

enum BodyType {
  SLIM
  ATHLETIC
  CURVY
  PLUS_SIZE
  MUSCULAR
  AVERAGE
  PREFER_NOT_TO_SAY
}

enum PortfolioItemType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LINK
}

enum SubscriptionPlan {
  STANDARD
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CommentStatus {
  APPROVED
  PENDING
  FLAGGED
  REJECTED
}

// Notifications persisted for each talent profile
model TalentNotification {
  id              String           @id @default(cuid())
  talentProfile   TalentProfile    @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String
  type            NotificationType
  title           String
  message         String
  read            Boolean          @default(false)
  dismissed       Boolean          @default(false)
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([talentProfileId, createdAt])
  @@index([talentProfileId, read, dismissed])
  @@map("Notification")
}

enum NotificationType {
  PROFILE_VIEW
  PROFILE_COMMENT
  PROFILE_LIKE
  MESSAGE
  SYSTEM
}

model Comment {
  id         String        @id @default(cuid())
  content    String
  status     CommentStatus @default(APPROVED)
  likesCount Int           @default(0)
  isPinned   Boolean       @default(false)
  pinnedAt   DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Comment can be on a portfolio item (video) or on a profile
  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  portfolioItemId String?

  talentProfile   TalentProfile? @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String?

  // Support for threaded comments (replies)
  parentComment   Comment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  parentCommentId String?
  replies         Comment[] @relation("CommentReplies")

  likes   CommentLike[]
  reports ContentReport[]

  @@index([userId])
  @@index([portfolioItemId])
  @@index([talentProfileId])
  @@index([parentCommentId])
  @@index([status])
}

model CommentLike {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String

  @@unique([userId, commentId])
  @@index([userId])
  @@index([commentId])
}

model ContentReport {
  id String @id @default(cuid())

  // Who reported (required)
  reportedBy   User   @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  reportedById String

  // What was reported (can be a talent profile, portfolio item, or comment)
  reportedProfile   TalentProfile? @relation(fields: [reportedProfileId], references: [userId], onDelete: Cascade)
  reportedProfileId String?

  portfolioItem   PortfolioItem? @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  portfolioItemId String?

  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String?

  // Who the report is about (can be the talent owner or comment author)
  reportedUser   User   @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedUserId String

  // Who handled the report (admin)
  handler   User?   @relation("ReportHandler", fields: [handlerId], references: [id], onDelete: SetNull)
  handlerId String?

  // Report details
  type       ReportType
  reason     String
  status     ReportStatus @default(PENDING)
  resolution String? // Resolution notes from admin

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportedById])
  @@index([reportedProfileId])
  @@index([portfolioItemId])
  @@index([commentId])
  @@index([reportedUserId])
  @@index([handlerId])
  @@index([status])
  @@index([type])
  @@map("Report")
}

enum ReportType {
  SPAM
  INAPPROPRIATE_CONTENT
  HARASSMENT
  FAKE_PROFILE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

model ProfileView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Viewer (null if anonymous)
  viewer   User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerId String?

  // Viewed profile
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  // Metadata
  ipAddress String?
  userAgent String?
  referrer  String?
  duration  Int? // Time spent on profile in seconds

  @@index([talentProfileId])
  @@index([viewerId])
  @@index([createdAt])
}

model PortfolioView {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Viewer (null if anonymous)
  viewer   User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)
  viewerId String?

  // Viewed portfolio item
  portfolioItem   PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  portfolioItemId String

  // Metadata
  duration  Int? // Time spent viewing in seconds
  completed Boolean @default(false) // For videos/audio

  @@index([portfolioItemId])
  @@index([viewerId])
  @@index([createdAt])
}

model SearchAppearance {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // Search query
  searchQuery   String
  searchFilters Json? // Store filter criteria

  // Profile that appeared in results
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  // Position in search results
  position Int
  clicked  Boolean @default(false)

  @@index([talentProfileId])
  @@index([createdAt])
  @@index([searchQuery])
}

model ProfileStats {
  id   String   @id @default(cuid())
  date DateTime @db.Date

  // Profile
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  // Daily aggregated stats
  views             Int @default(0)
  uniqueViews       Int @default(0)
  profileLikes      Int @default(0)
  portfolioViews    Int @default(0)
  searchImpressions Int @default(0)
  searchClicks      Int @default(0)
  comments          Int @default(0)

  @@unique([talentProfileId, date])
  @@index([talentProfileId])
  @@index([date])
}

// User Analytics & Sessions
model UserSession {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  ipAddress String?
  userAgent String?

  startedAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  duration Int @default(0) // in seconds

  deviceType String? // "mobile", "desktop"
  browser    String?
  os         String?

  path String? // Landing path

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([startedAt])
  @@index([ipAddress])
}

// Activity Logging (Audit Trail)
model ActivityLog {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  action  String // e.g., "LOGIN", "PROFILE_UPDATE", "PASSWORD_CHANGE"
  details Json? // e.g., { field: "bio", oldValue: "...", newValue: "..." }

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// Email Logs (Integration with Resend)
model EmailLog {
  id String @id @default(cuid())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Resend specific fields
  providerMessageId String? @unique // Resend ID

  templateId String?
  type       String // e.g., "WELCOME", "RESET_PASSWORD", "MARKETING"
  subject    String?

  status EmailStatus @default(SENT)
  error  String?

  openedAt  DateTime?
  clickedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([providerMessageId])
  @@index([createdAt])
}

enum EmailStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SPAM_COMPLAINT
}

// System Monitoring
model SystemMetric {
  id        String           @id @default(cuid())
  type      SystemMetricType
  value     Float // duration in ms, or count
  name      String // e.g., "api_request_duration", "db_query_duration"
  tags      Json? // e.g., { path: "/api/users", method: "GET" }
  createdAt DateTime         @default(now())

  @@index([type, createdAt])
}

enum SystemMetricType {
  API_REQUEST
  DB_QUERY
  ERROR_LOG
  SYSTEM_HEALTH
}

// CMS (Content Management System)
model ContentPage {
  slug         String  @id // e.g., "terms-of-service"
  internalNote String? @map("description") // Internal note: "Legal terms page"

  versions  ContentVersion[]
  published PublishedContent[]
}

// Stores the pointer to the currently active version for a specific locale
model PublishedContent {
  id String @id @default(cuid())

  page     ContentPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  pageSlug String

  locale String // e.g., "en", "es", "fr"

  version   ContentVersion @relation(fields: [versionId], references: [id])
  versionId String

  @@unique([pageSlug, locale]) // Only one published version per page per locale
}

model ContentVersion {
  id String @id @default(cuid())

  page     ContentPage @relation(fields: [pageSlug], references: [slug], onDelete: Cascade)
  pageSlug String

  locale     String // Language of this specific version
  title      String // Localized title
  content    String  @db.Text // HTML or Markdown
  changeNote String? @map("changelog") // "Updated pricing section"

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())

  // Back-relation to see if this version is published
  publishedEntry PublishedContent[]
}

// Communications System
model EmailTemplate {
  id            String   @id // e.g., "welcome-email"
  name          String
  subject       String
  body          String   @db.Text // HTML with {{variables}}
  preheaderText String? // Short text shown in inbox preview
  variables     String[] // List of available variables for this template
  lastUpdated   DateTime @updatedAt
}

model GlobalNotification {
  id         String                 @id @default(cuid())
  title      String
  message    String
  type       GlobalNotificationType // INFO, WARNING, CRITICAL
  targetRole UserRole? // Null = All, or specific role
  active     Boolean                @default(true)
  expiresAt  DateTime?
  createdAt  DateTime               @default(now())
}

enum GlobalNotificationType {
  INFO
  WARNING
  CRITICAL
}

// Financials
model FinancialTransaction {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  type     FinancialTransactionType
  amount   Int // in cents
  currency String                     @default("gbp")
  status   FinancialTransactionStatus @default(COMPLETED)

  // Links
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?

  payment   Payment? @relation(fields: [paymentId], references: [id])
  paymentId String?

  // External references
  stripeId  String? // PaymentIntent ID or Refund ID
  invoiceId String?

  description String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([subscriptionId])
  @@index([paymentId])
}

enum FinancialTransactionType {
  PAYMENT
  REFUND
  ADJUSTMENT
  CREDIT
}

enum FinancialTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Verification
model VerificationRequest {
  id              String        @id @default(cuid())
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  type   VerificationType
  status VerificationStatus @default(PENDING)

  // Data
  documents       String[] // URLs to uploaded documents
  notes           String? // Admin internal notes
  rejectionReason String? // Reason sent to user

  // Admin handling
  handler   User?   @relation(fields: [handlerId], references: [id])
  handlerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talentProfileId])
  @@index([status])
  @@index([type])
  @@index([handlerId])
}

enum VerificationType {
  IDENTITY
  PROFESSIONAL // e.g., union status, qualifications
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

model BackgroundCheck {
  id              String        @id @default(cuid())
  talentProfile   TalentProfile @relation(fields: [talentProfileId], references: [userId], onDelete: Cascade)
  talentProfileId String

  provider   String? // e.g., "Checkr"
  providerId String? // External ID

  status    BackgroundCheckStatus @default(PENDING)
  result    String? // "CLEAR", "CONSIDER", etc.
  reportUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([talentProfileId])
  @@index([status])
}

enum BackgroundCheckStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// --- Support System ---

model SupportTicket {
  id       String                @id @default(cuid())
  subject  String
  message  String                @db.Text
  status   SupportTicketStatus   @default(OPEN)
  priority SupportTicketPriority @default(MEDIUM)
  category SupportTicketCategory @default(OTHER)

  // Creator (authenticated users only)
  user       User?   @relation("TicketCreator", fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  guestEmail String? // Legacy field, kept for migration compatibility

  // Assignment
  assignedTo   User?   @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  // Internal
  tags          String[] // ["billing", "technical"]
  internalNotes String?  @db.Text

  // Threaded messages (admin/user replies)
  messages SupportTicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@index([assignedToId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_USER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  ACCOUNT
  BILLING
  PORTFOLIO
  CATEGORIES
  NOTIFICATIONS
  SECURITY
  OTHER
}

model KnowledgeBaseArticle {
  id       String   @id @default(cuid())
  title    String
  slug     String   @unique
  content  String   @db.Text
  category String // e.g., "Getting Started", "Billing"
  tags     String[]

  isPublished Boolean @default(false)
  viewCount   Int     @default(0)

  author   User   @relation(fields: [authorId], references: [id])
  authorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([slug])
  @@index([isPublished])
}

// --- CMS System ---

model MediaAsset {
  id       String    @id @default(cuid())
  filename String
  url      String
  type     MediaType // IMAGE, VIDEO, DOCUMENT
  mimeType String?
  size     Int? // in bytes

  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  altText String?
  folder  String? // e.g., "/avatars", "/posts"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([uploadedById])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

model SeoMetadata {
  id    String @id @default(cuid())
  route String @unique // e.g., "/", "/pricing", "/talent/[id]"

  title       String
  description String?
  keywords    String[]
  ogImage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminNotificationState {
  id            String   @id @default(cuid())
  adminId       String   @unique
  admin         User     @relation("AdminNotifState", fields: [adminId], references: [id], onDelete: Cascade)
  lastClearedAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([adminId])
}
